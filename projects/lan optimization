  <!-- CONFIGS -->
  <section class="reveal">
    <div class="sec-title">Configuration</div>
    <h2>Key Config Extracts</h2>

    <div class="code-label">VLAN &amp; SVI Configuration (Distribution Switch)</div>
    <div class="code-block"><pre>! VLAN definitions
vlan 10
 name Corporate
vlan 20
 name Voice
vlan 30
 name Guest
vlan 50
 name Management

! SVIs for inter-VLAN routing
interface Vlan10
 ip address 10.10.10.2 255.255.255.0
 ip helper-address 10.10.60.10
 no shutdown
interface Vlan20
 ip address 10.10.20.2 255.255.255.0
 no shutdown</pre></div>

    <div class="code-label">HSRP Configuration (VLAN 10 — Active/Standby)</div>
    <div class="code-block"><pre>interface Vlan10
 ip address 10.10.10.2 255.255.255.0
 standby version 2
 standby 10 ip 10.10.10.1
 standby 10 priority 110
 standby 10 preempt
 standby 10 track GigabitEthernet1/0/1 20</pre></div>

    <div class="code-label">OSPF Configuration</div>
    <div class="code-block"><pre>router ospf 1
 router-id 1.1.1.1
 network 10.10.10.0 0.0.0.255 area 0
 network 10.10.20.0 0.0.0.255 area 0
 network 10.10.30.0 0.0.0.255 area 0
 network 10.10.50.0 0.0.0.255 area 0
 passive-interface default
 no passive-interface GigabitEthernet1/0/49</pre></div>

    <div class="code-label">ACL — Block Guest from Corporate (applied on Vlan30 inbound)</div>
    <div class="code-block"><pre>ip access-list extended BLOCK-GUEST-TO-CORP
 deny   ip 192.168.30.0 0.0.0.255 10.10.10.0 0.0.0.255
 deny   ip 192.168.30.0 0.0.0.255 10.10.60.0 0.0.0.255
 permit ip 192.168.30.0 0.0.0.255 any

interface Vlan30
